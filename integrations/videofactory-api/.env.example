# Local-only by default. Use 0.0.0.0 only when remote access is required.
PRODUCER_HOST=127.0.0.1
PRODUCER_PORT=9847

# Requests may only render projects inside this directory.
PRODUCER_PROJECTS_DIR=./api-projects
PRODUCER_RENDERS_DIR=./api-renders

# Keep at 1 on a single workstation to avoid competing for GPU/CPU resources.
PRODUCER_MAX_CONCURRENT_RENDERS=1

# Leave blank for localhost-only use.
# A non-loopback PRODUCER_HOST requires a strong token.
PRODUCER_AUTH_TOKEN=

# Optional comma-separated proxy/browser host names.
PRODUCER_ALLOWED_HOSTS=
